# --- Required -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me

# --- Hosting ------------------------------------------------------------------
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080
# Once the stack is served over HTTPS (TLS in front of the frontend container),
# enforce it. This redirects HTTP to HTTPS in nginx and Django and sends HSTS
# (one year by default; override with DJANGO_SECURE_HSTS_SECONDS).
# DJANGO_SECURE_SSL_REDIRECT=1
# Secure cookies are on by default when DJANGO_DEBUG is off; set 0 only for plain-HTTP local use.
# DJANGO_SECURE_COOKIES=0
# Proxies that append to X-Forwarded-For in front of Django: 1 = the bundled nginx.
# Add one for each load balancer in front of nginx, or rate limits and audit IPs are wrong.
# DJANGO_NUM_PROXIES=1
HTTP_PORT=8080

# --- Organisation (external risk monitoring) -------------------------------------
THREATDASH_ORG_NAME=Example Corp
THREATDASH_ORG_DOMAINS=example.com

# --- Response automation ----------------------------------------------------------
# "simulated" (default) changes platform state only. "webhook" POSTs signed actions
# (X-ThreatDash-Signature: sha256=HMAC) to your EDR/SOAR integration.
THREATDASH_RESPONSE_CONNECTOR=simulated
# THREATDASH_RESPONSE_WEBHOOK_URL=https://soar.example.com/hooks/threatdashboard
# THREATDASH_RESPONSE_WEBHOOK_SECRET=

# --- Optional: Claude-powered natural-language queries --------------------------------
# ANTHROPIC_API_KEY=
# THREATDASH_NLQ_MODEL=claude-opus-5-5

# --- Security ----------------------------------------------------------------------
# API tokens expire after this many hours (0 = never).
# THREATDASH_TOKEN_TTL_HOURS=12
# Feeds are blocked from private/loopback/metadata addresses (SSRF guard) unless enabled.
# THREATDASH_FEED_ALLOW_PRIVATE_NETWORKS=0
# THREATDASH_THROTTLE_LOGIN=10/min
# THREATDASH_THROTTLE_INGEST=600/min

# --- Tuning -------------------------------------------------------------------------
# THREATDASH_MAX_IMPORT_BYTES=20971520
# THREATDASH_RISK_HALF_LIFE_DAYS=30
# THREATDASH_DEFAULT_INDICATOR_TTL_DAYS=90
# THREATDASH_EXFIL_BYTES=524288000
# THREATDASH_THROTTLE_USER=600/min
