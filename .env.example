# --- Required -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me

# --- Hosting ------------------------------------------------------------------
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080
# Enable these once the stack is served over HTTPS:
# DJANGO_SECURE_COOKIES=1
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
HTTP_PORT=8080

# --- Organisation (external risk monitoring) -------------------------------------
THREATDASH_ORG_NAME=Example Corp
THREATDASH_ORG_DOMAINS=example.com

# --- Response automation ----------------------------------------------------------
# "simulated" (default) changes platform state only. "webhook" POSTs signed actions
# (X-ThreatDash-Signature: sha256=HMAC) to your EDR/SOAR integration.
THREATDASH_RESPONSE_CONNECTOR=simulated
# THREATDASH_RESPONSE_WEBHOOK_URL=https://soar.example.com/hooks/threatdashboard
# THREATDASH_RESPONSE_WEBHOOK_SECRET=

# --- Optional: Claude-powered natural-language queries --------------------------------
# ANTHROPIC_API_KEY=
# THREATDASH_NLQ_MODEL=claude-opus-5-5

# --- Tuning -------------------------------------------------------------------------
# THREATDASH_MAX_IMPORT_BYTES=20971520
# THREATDASH_RISK_HALF_LIFE_DAYS=30
# THREATDASH_DEFAULT_INDICATOR_TTL_DAYS=90
# THREATDASH_EXFIL_BYTES=524288000
# THREATDASH_THROTTLE_USER=600/min
