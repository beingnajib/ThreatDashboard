# Rendered at container start by the nginx image's envsubst step. Only
# THREATDASH_* variables are substituted (NGINX_ENVSUBST_FILTER in the Dockerfile),
# so nginx's own $variables are left alone.

# Scheme the client actually used. When TLS ends at a load balancer in front of
# this container, it sends X-Forwarded-Proto; otherwise this is our own scheme.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map "${THREATDASH_FORCE_HTTPS}:$forwarded_proto" $hsts_header {
    "1:https" "max-age=31536000";
    default   "";
}

map "${THREATDASH_FORCE_HTTPS}:$forwarded_proto" $redirect_to_https {
    "1:http" 1;
    default  0;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 25m;
    server_tokens off;

    include /etc/nginx/snippets/security-headers.conf;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # Container healthcheck (the Dockerfile's HEALTHCHECK sends X-Forwarded-Proto:
    # https so it isn't redirected when HTTPS is enforced).
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    if ($redirect_to_https) {
        return 301 https://$host$request_uri;
    }

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 180s;
    }

    location /admin/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /static/ {
        proxy_pass http://backend:8000;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri /index.html;
    }
}
